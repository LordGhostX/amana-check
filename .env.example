# Copy to .env and fill in. Never commit real values.

# Public origin used for metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://amana-check.vercel.app

# Postgres connection string. Local dev: postgresql://localhost:5432/amana_check
# Production: use the pooled Neon connection string.
DATABASE_URL=postgresql://localhost:5432/amana_check

# Direct connection used by migrations and the ingestion lock. Required for ingestion.
# Local Postgres has no pooler, so use the same URL as DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://localhost:5432/amana_check

# Preferred LLM provider. If this is blank, the AI Gateway key below is used.
# OpenRouter requests are hardcoded to ZDR + data_collection=deny and fail closed.
OPENROUTER_API_KEY=

# Optional Vercel AI Gateway key. Used only when OPENROUTER_API_KEY is blank.
AI_GATEWAY_API_KEY=

# Ordered fallback chain, comma-separated.
OPENROUTER_MODELS=deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4-flash-0731

# Shared secret for rate-limit IP hashing and admin session signing. Raw IPs are never stored.
APP_SECRET=replace-with-openssl-rand-hex-32

# Secret sent by Vercel when it invokes the ingestion cron route.
CRON_SECRET=replace-me

# Passcode for the admin review queue. Set a strong value; the template value is refused in production.
ADMIN_PASSCODE=replace-me

# Optional label shown on reviewed versions.
ADMIN_NAME=reviewer

# Maximum LLM spend per day in USD before the ask endpoint fails closed.
DAILY_COST_LIMIT_USD=5

# Ingestion retries bot-blocked feeds (e.g. ReliefWeb country feeds) through curl.
# Set to 0 to disable the fallback and fail fast instead.
INGEST_CURL_FALLBACK=1
