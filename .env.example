# Copy to .env and fill in. Never commit real values.

# Postgres connection string. Local dev: postgresql://localhost:5432/amana_check
# Production: use the pooled Neon connection string.
DATABASE_URL=postgresql://localhost:5432/amana_check

# OpenRouter API key. Requests are hardcoded to ZDR + data_collection=deny and fail closed.
OPENROUTER_API_KEY=

# Ordered fallback chain, comma-separated.
OPENROUTER_MODELS=deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4-flash-0731

# HMAC secret used only for rate limits and locale hints. Raw IPs are never stored.
IP_HASH_SECRET=replace-with-openssl-rand-hex-32

# Passcode for the admin review queue.
ADMIN_PASSCODE=replace-me
