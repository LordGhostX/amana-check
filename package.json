{
  "name": "amana-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bun run db:setup && next start",
    "lint": "eslint",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "db:studio": "drizzle-kit studio",
    "ingest": "bun run scripts/ingest.ts",
    "ask": "bun run scripts/ask.ts",
    "eval": "bun run scripts/eval.ts",
    "red-team": "bun run scripts/red-team.ts",
    "check:llm": "bun run scripts/check-llm.ts",
    "check:pipeline": "bun run scripts/check-pipeline.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "html-to-text": "^10.0.1",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
